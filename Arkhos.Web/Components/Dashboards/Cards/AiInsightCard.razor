@using MudBlazor

<div class="glass-insight-card pa-4 pa-md-5">
    
    <div class="card-content-wrapper d-flex flex-column flex-md-row align-start align-md-center" style="gap: 16px;">
        
        <div class="d-flex flex-row flex-grow-1 align-start align-md-center w-100" style="gap: 16px;">
            
            <MudPaper Elevation="0" Class="d-flex align-center justify-center rounded pa-2 flex-shrink-0 mt-1 mt-md-0" 
                      Style="background-color: rgba(37, 40, 61, 0.7); color: #9A86FD; min-width: 48px; min-height: 48px;">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Medium" />
            </MudPaper>

            <div class="d-flex flex-column flex-grow-1">
                <MudText Typo="Typo.body1" Style="color: #FFFFFF; line-height: 1.5;">
                    <span style="font-weight: 600;">@_displayTitle</span>
                    
                    @if (_showHighlight)
                    {
                        <span class="insight-highlight">@HighlightValue</span>
                    }
                </MudText>
                
                <MudText Typo="Typo.body2" Style="color: #A0AAB4; margin-top: 6px; line-height: 1.5;" Class="@(_isTyping ? "blinking-cursor" : "")">
                    @_displayRecommendation
                </MudText>
            </div>
            
        </div>

        <MudButton Variant="Variant.Text" Style="color: #9A86FD; font-weight: 600; text-transform: none; white-space: nowrap;"
                   EndIcon="@Icons.Material.Filled.ArrowForward" Class="flex-shrink-0 align-self-end align-self-md-center mt-2 mt-md-0 px-2">
            VER PLANO
        </MudButton>
        
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string HighlightValue { get; set; } = string.Empty;
    [Parameter] public string Recommendation { get; set; } = string.Empty;

    private string _displayTitle = "";
    private string _displayRecommendation = "";
    private bool _showHighlight = false;
    private bool _isTyping = false;
    
    // Instância única de Random para gerar o efeito orgânico
    private Random _rand = new Random();
    private CancellationTokenSource _cts = new();

    protected override async Task OnParametersSetAsync()
    {
        _cts.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        _displayTitle = "";
        _displayRecommendation = "";
        _showHighlight = false;
        _isTyping = false;

        try
        {
            // 1. Digita o Título (Mais rápido)
            await TypeWordsAsync(Title, s => _displayTitle = s, 30, token);

            // 2. Revela o Valor com uma pausa dramática
            if (!string.IsNullOrEmpty(HighlightValue) && HighlightValue != "..." && HighlightValue != "-")
            {
                _showHighlight = true;
                StateHasChanged();
                await Task.Delay(250, token); // Pausa maior para o usuário notar o número
            }

            // 3. Digita a Recomendação (Ritmo de leitura)
            _isTyping = true;
            await TypeWordsAsync(Recommendation, s => _displayRecommendation = s, 40, token);
            
            _isTyping = false;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
        }
    }

    // NOVA FUNÇÃO: Digita por palavras (Tokens), muito mais fluido!
    private async Task TypeWordsAsync(string fullText, Action<string> updater, int baseDelayMs, CancellationToken token)
    {
        if (string.IsNullOrEmpty(fullText)) return;
        
        string[] words = fullText.Split(' ');
        string currentText = "";
        
        foreach (var word in words)
        {
            token.ThrowIfCancellationRequested(); 
            currentText += word + " ";
            updater(currentText.TrimEnd());
            StateHasChanged(); 
            
            // Randomiza o delay para parecer uma IA "pensando" (Fluidez orgânica)
            int randomDelay = _rand.Next(baseDelayMs, baseDelayMs + 35);
            await Task.Delay(randomDelay, token); 
        }
    }
}