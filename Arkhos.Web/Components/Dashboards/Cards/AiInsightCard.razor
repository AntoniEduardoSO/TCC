@using MudBlazor

<MudPaper Class="d-flex align-center pa-3" Elevation="0" Style="background-color: #1A1C29; border: 1px solid #2A2D3D; border-radius: 8px; gap: 16px;">
    
    <MudPaper Elevation="0" Class="d-flex align-center justify-center rounded pa-2" 
              Style="background-color: #25283D; color: #9A86FD; min-width: 44px; min-height: 44px;">
        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
    </MudPaper>

    <div class="d-flex flex-column flex-grow-1">
        <MudText Typo="Typo.subtitle2" Style="font-weight: 600; color: #FFFFFF;">
            @Title
            <span style="color: #00B0FF; margin: 0 4px;">@HighlightValue</span>
            <span style="font-weight: 400; color: #A0AAB4;">@Description</span>
        </MudText>
        
        <MudText Typo="Typo.body2" Style="color: #A0AAB4;">
            @Recommendation
        </MudText>
    </div>

    <MudButton Variant="Variant.Text" Style="color: #6C5DD3; font-weight: 600;"
               EndIcon="@Icons.Material.Filled.ArrowForward" Class="ml-4">
        VER PLANO
    </MudButton>

</MudPaper>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string HighlightValue { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string Recommendation { get; set; } = string.Empty;
}