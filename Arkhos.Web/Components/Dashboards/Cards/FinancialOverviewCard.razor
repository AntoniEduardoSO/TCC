@using MudBlazor
@using Arkhos.Web.Models

@inject IDialogService DialogService

<MudPaper Elevation="0" Class="pa-4"
          Style="background-color: #1a1f2e; height: 100%; color: white; border-radius: 12px; border: 1px solid #2d3748;">
    
    <div class="d-flex justify-space-between align-start mb-4">
        <div>
            <MudText Typo="Typo.h6" Style="font-weight: 500; color: #e2e8f0;">
                @Title <span style="color: #48bb78;">. @Subtitle</span>
            </MudText>
            <MudText Typo="Typo.caption" Style="color: #a0aec0;">@Description</MudText>
        </div>
        
        <div
            style="background-color: #111420; color: #e2e8f0; border-radius: 8px; border: 1px solid #2d3748; display: flex; align-items: center; padding: 6px 10px; gap: 8px;">
            <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" Style="color: #48bb78;" />
            <div>
                <MudText Typo="Typo.caption" Style="color: #a0aec0; font-size: 0.65rem;">Gasto Médio Consolidado
                </MudText>
                <MudText Typo="Typo.body2" Style="font-weight: 600;">
                    @TotalGasto.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))
                </MudText>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2" style="justify-content: space-between;">
        <DashboardMetricCard Icon="@Icons.Material.Filled.Face" Title="Gasto Por\nAluno"
                             Value="@AvgStudent.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))"
                             OnInfoClick="@(() => OpenInfo("gastoAluno"))" />
        <DashboardMetricCard Icon="@Icons.Material.Filled.School" Title="Gasto Por\nProfessor"
                             Value="@AvgTeacher.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))" 
                             OnInfoClick="@(() => OpenInfo("gastoProfessor"))"/>
        <DashboardMetricCard Icon="@Icons.Material.Filled.Build" Title="Gasto\nInfraestrutura"
                             Value="@AvgInfra.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))" 
                              OnInfoClick="@(() => OpenInfo("gastoInfraestrutura"))"/>
        <DashboardMetricCard Icon="@Icons.Material.Filled.DirectionsBus" Title="Gasto\nTransporte Por Aluno"
                             Value="@AvgTransport.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))" />
        <DashboardMetricCard Icon="@Icons.Material.Filled.Fastfood" Title="Gasto\nMerenda Por Aluno"
                             Value="@AvgMeal.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))" />
    </div>

</MudPaper>

<style>
    .mud-dialog-title {
        background: linear-gradient(135deg, #1e293b, #0f172a);
        color: #f1f5f9;
    }
</style>

@code {
    [Parameter] public string Title { get; set; } = "Educação: Gastos mensais";
    [Parameter] public string Subtitle { get; set; } = "(Médios)";
    [Parameter] public string Description { get; set; } = "Dados através dos portais da transparência e SIOPE.";
    [Parameter] public double AvgStudent { get; set; }
    [Parameter] public double AvgTeacher { get; set; }
    [Parameter] public double AvgInfra { get; set; }
    [Parameter] public double AvgTransport { get; set; }
    [Parameter] public double AvgMeal { get; set; }
    [Parameter] public double TotalGasto { get; set; }
    [Parameter] public EventCallback OnInfoClick { get; set; }

    private async Task OpenInfo(string key)
    {
        await DialogService.ShowAsync<InfoDialog>("", new DialogParameters
        {
            ["Data"] = InfoDialogs.Data[key]
        });
    }
}