@using MudBlazor
@using Arkhos.Web.Models
@inject IJSRuntime JS

<MudDialog MaxWidth="MaxWidth.ExtraLarge" FullWidth="true" Style="max-width: 50vw; width: 50vw;">
    <TitleContent>
        <MudText Typo="Typo.h6">@Data.Title</MudText>
    </TitleContent>

    <DialogContent>

        $$ @((MarkupString)Data.FormulaLatex) $$

        <MudList Dense="true" T="string">
            @foreach (var item in Data.Definitions)
            {
                <MudListItem>
                    <b>\(@item.SymbolLatex)</b> — @item.Description
                </MudListItem>
            }
        </MudList>

        <MudText Class="mt-2">
            @Data.Explanation
        </MudText>

    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Filled" Color="Color.Primary">Fechar</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .modal-header-custom {
        background: var(--mud-palette-dark);
        color: var(--mud-palette-dark-text);
        padding: 16px 20px;
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
    }
</style>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public InfoDialogData Data { get; set; }

    private void Cancel() => MudDialog.Cancel();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("MathJax.typeset");
    }
}