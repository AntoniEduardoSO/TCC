@using MudBlazor

<MudPaper Elevation="0" Class="pa-4" Style="background-color: #1a1f2e; height: 100%; border-radius: 12px; border: 1px solid #2d3748;">
    
    <div class="d-flex justify-space-between align-start mb-4">
        <div>
            <MudText Typo="Typo.h6" Style="font-weight: 500; color: #e2e8f0; font-size: 1.1rem;">
                Matrículas
            </MudText>
            <MudText Typo="Typo.caption" Style="color: #a0aec0;">Distribuição por etapas de ensino (@Ano).</MudText>
        </div>
        
        <div class="flex-shrink-0" style="background-color: #111420; border-radius: 8px; border: 1px solid #2d3748; padding: 6px 10px; text-align: center;">
            <MudText Typo="Typo.caption" Style="color: #a0aec0; font-size: 0.6rem; display: block;">Total Alunos</MudText>
            <MudText Typo="Typo.body1" Style="font-weight: 700; color: #e2e8f0; line-height: 1;">
                @TotalGeral.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)
            </MudText>
        </div>
    </div>

    <div class="d-flex flex-column gap-2">
        @foreach (var item in GetEnrollmentRows())
        {
            <div class="d-flex justify-space-between align-center px-3 py-2 w-100" style="background-color: transparent; border-radius: 6px; border: 1px solid #2d3748;">
                <div class="d-flex align-center gap-2 flex-grow-1 overflow-hidden">
                    <MudIcon Icon="@item.Icon" Size="Size.Small" Style="color: #94a3b8; font-size: 1rem;" Class="flex-shrink-0" />
                    <MudText Typo="Typo.body2" Style="color: #e2e8f0; font-weight: 500; font-size: 0.85rem; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">@item.Label</MudText>
                </div>
                <div class="flex-shrink-0" style="background-color: #21283a; padding: 2px 8px; border-radius: 4px; margin-left: 8px;">
                    <MudText Typo="Typo.body2" Style="font-weight: 600; font-size: 0.85rem; color: #ffffff;">
                        @item.Value.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)
                    </MudText>
                </div>
            </div>
        }
    </div>
</MudPaper>

@code {
    [Parameter] public int Ano { get; set; } = 2024;
    [Parameter] public double TotalCreche { get; set; }
    [Parameter] public double TotalPreEscola { get; set; }
    [Parameter] public double TotalFundIniciais { get; set; }
    [Parameter] public double TotalFundFinais { get; set; }
    [Parameter] public double TotalMedio { get; set; }

    private double TotalGeral => TotalCreche + TotalPreEscola + TotalFundIniciais + TotalFundFinais + TotalMedio;

    private IEnumerable<(string Icon, string Label, double Value)> GetEnrollmentRows()
    {
        yield return (Icons.Material.Filled.ChildCare, "Creche", TotalCreche);
        yield return (Icons.Material.Filled.EscalatorWarning, "Pré-escola", TotalPreEscola);
        yield return (Icons.Material.Filled.MenuBook, "Ens. Fund. (Anos Iniciais)", TotalFundIniciais);
        yield return (Icons.Material.Filled.AutoStories, "Ens. Fund. (Anos Finais)", TotalFundFinais);
        yield return (Icons.Material.Filled.School, "Ensino Médio", TotalMedio);
    }
}