@page "/schoolrating-test"
@using Arkhos.Core.Handlers
@using Arkhos.Core.Models.Dto
@using Arkhos.Core.Requests.SchoolRatings
@using Arkhos.Core.Responses

@inject ISchoolRatingsHandler Handler


<PageTitle>SchoolRating Test</PageTitle>


<h1>SchoolRating (Debug)</h1>

@if (response == null)
{
    <p style="color: white"><em>Loading...</em></p>
}
else
{
    <pre style="color: white">@json</pre>
}

@code
{
    private Response<ICollection<SchoolRatingSpendingDto>>? response;
    private string? json;

    protected override async Task OnInitializedAsync()
    {
        var request = new GetSchoolRatingByYearRequest
        {
            Year = 2024 // ajusta conforme necessário
        };

        response = await Handler.GetByYearAsync(request);

        json = System.Text.Json.JsonSerializer.Serialize(
            response,
            new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true
            });
    }
}