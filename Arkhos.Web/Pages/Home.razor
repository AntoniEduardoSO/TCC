@page "/"
@using Arkhos.Core.Handlers
@using Arkhos.Core.Interfaces
@using Arkhos.Core.Models
@using Arkhos.Core.Models.Dto.SchoolEnrollValues
@using Arkhos.Core.Models.Dto.SchoolInfo
@using Arkhos.Core.Models.Dto.SchoolRating
@using Arkhos.Core.Models.Dto.SchoolInfraValues
@using Arkhos.Core.Requests
@using Arkhos.Core.Requests.SchoolEnrollValues
@using Arkhos.Core.Requests.SchoolInfos
@using Arkhos.Core.Requests.SchoolInfraValues
@using Arkhos.Core.Requests.SchoolRatings
@using Arkhos.Core.Requests.TargetInsights
@using Arkhos.Core.Responses
@using Arkhos.Web.Components.Dashboards.Cards
@using Arkhos.Web.Handlers

@inject ISchoolInfosHandler Handler
@inject ISchoolRatingsHandler RatingHandler
@inject ISchoolEnrollValuesHandler EnrollHandler
@inject ISchoolInfraValuesHandler InfraHandler
@inject DashboardStateService DashboardState
@inject ITargetInsightsHandler TargetInsightHandler
@inject IJSRuntime JS

<PageTitle>Dashboard - Arkhos</PageTitle>

<div class="mb-6">
    <AiInsightCard Title="@InsightTitle" HighlightValue="@InsightHighlight" Recommendation="@InsightRecommendation" />
</div>

<MudGrid Spacing="3">

    <MudItem xs="12" lg="5" xl="6">
        <MudStack Spacing="3">
            <MudPaper Elevation="3" Class="d-flex align-center justify-center mud-width-full"
                Style="position: relative; height: 440px;">
                <div id="map" style="height:100%; width:100%; border-radius: 8px;"></div>
                <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" Label="Voltar"
                    Size="Size.Small" Style="position: absolute; top: 10px; right: 10px; z-index: 1000;"
                    @onclick="GoBack" />
            </MudPaper>

            <FinancialOverviewCard AvgStudent="@(ratingSummary?.AvgSpendingPerStudent ?? 0)"
                AvgTeacher="@(ratingSummary?.AvgSpendingPerTeacher ?? 0)"
                AvgInfra="@(ratingSummary?.AvgInfrastructureSpending ?? 0)"
                AvgTransport="@((ratingSummary?.AvgSpendingPerStudent ?? 0) * 0.15)"
                AvgMeal="@((ratingSummary?.AvgSpendingPerStudent ?? 0) * 0.10)"
                TotalGasto="@(((ratingSummary?.AvgSpendingPerStudent ?? 0) * (regionSummary?.MatriculaTotal ?? 0)) / 12.0)" />
        </MudStack>
    </MudItem>

    <MudItem xs="12" lg="7" xl="6">
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6">
                <MudStack Spacing="3">
                    <EnrollmentOverviewCard Ano="@DashboardState.SelectedYear"
                        TotalCreche="@(regionSummary?.MatriculaCreche ?? 0)"
                        TotalPreEscola="@(regionSummary?.MatriculaPreEscola ?? 0)"
                        TotalFundIniciais="@(regionSummary?.MatriculaEnsinoFundamentalAI ?? 0)"
                        TotalFundFinais="@(regionSummary?.MatriculaEnsinoFundamentalAF ?? 0)"
                        TotalMedio="@(regionSummary?.MatriculaEnsinoMedio ?? 0)" />

                    <TeachersOverviewCard Ano="@DashboardState.SelectedYear"
                        TotalCreche="@(regionSummary?.ProfessorCreche ?? 0)"
                        TotalPreEscola="@(regionSummary?.ProfessorPreEscola ?? 0)"
                        TotalFundIniciais="@(regionSummary?.ProfessorEFIniciais ?? 0)"
                        TotalFundFinais="@(regionSummary?.ProfessorEFFinais ?? 0)"
                        TotalMedio="@(regionSummary?.ProfessorMedio ?? 0)"
                        TotalEspecial="@(regionSummary?.ProfessorEspecial ?? 0)" />
                </MudStack>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudStack Spacing="3">
                    <PieChartDropoutRateCard TotalAbandonos="@(ratingSummary?.DropoutRate ?? 0)"
                        TotalAprovados="@(ratingSummary?.ApprovalRate ?? 0)"
                        TotalReprovados="@(ratingSummary?.FailureRate ?? 0)" Ano="@DashboardState.SelectedYear" />

                    <InfrastructureQualityCard Accessibility="@(ratingSummary?.AvgAccessibilityRating ?? 0)"
                        Pedagogical="@((infraSummary?.AvgPedagogicalRating ?? 0) / 10.0)"
                        WellBeing="@((infraSummary?.AvgWellbeingRating ?? 0) / 14.0)" />

                    <GovernanceSupportCard Psychologists="@((int)(regionSummary?.Psicologo ?? 0))"
                        SocialAssistants="@((int)(regionSummary?.AssistenteSocial ?? 0))"
                        Libras="@((int)(regionSummary?.TradutorLibras ?? 0))"
                        HasCouncil="@((regionSummary?.ConselhoEscolar ?? 0) > 0)"
                        HasParentsAssociation="@((regionSummary?.AssociacaoPaiMestres ?? 0) > 0)"
                        HasStudentUnion="@((regionSummary?.GremioEstudantil ?? 0) > 0)" />
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudItem>
</MudGrid>

@code {
    private Dictionary<string, RegionEnrollmentSummaryDto> _enrollmentCache = new();
    private Dictionary<string, RegionRatingSummaryDto> _ratingCache = new();
    private Dictionary<string, RegionInfraSummaryDto> _infraCache = new();

    private RegionEnrollmentSummaryDto? regionSummary;
    private RegionRatingSummaryDto? ratingSummary;
    private RegionInfraSummaryDto? infraSummary;
    private Response<ICollection<SchoolInfoMapDto>>? mapMarkersResponse;

    private bool _mapRendered = false;
    private DotNetObjectReference<Home>? _objRef;
    private string? _currentLevel;
    private int? _currentId;
    private TargetInsight? CurrentInsight;

    private string InsightTitle => CurrentInsight?.Titulo ?? "Analisando dados...";
    private string InsightHighlight => CurrentInsight?.ValorDestaque ?? "-";
    private string InsightRecommendation => CurrentInsight?.Recomendacao ?? "Selecione uma região no mapa.";

    protected override async Task OnInitializedAsync()
    {
        _objRef = DotNetObjectReference.Create(this);
        DashboardState.OnYearChanged += ReloadByYear;
        DashboardState.OnFilterChanged += ReloadByFilter;

        await LoadDashboardDataAsync(isInitial: true, reloadMarkers: true);

        _ = Task.Run(async () =>
        {
            foreach (var id in new[] { 1, 2, 3 })
                await GetEnrollmentWithCache(id, "meso");
        });
    }

    private async Task LoadDashboardDataAsync(bool isInitial = false, bool reloadMarkers = false)
    {
        if (isInitial) DashboardState.SetLoading(true);

        try
        {
            var year = DashboardState.SelectedYear;
            var dep = DashboardState.SelectedDependency;

            if (reloadMarkers || mapMarkersResponse == null)
            {
                var mapRequest = new GetSchoolInfoByYearRequest
                {
                    Year = year,
                    Dependencia = dep
                };
                mapMarkersResponse = await Handler.GetByYearAsync(mapRequest);
            }

            regionSummary = await GetEnrollmentWithCache(_currentId, _currentLevel);
            ratingSummary = await GetRatingWithCache(_currentId, _currentLevel);
            infraSummary = await GetInfraWithCache(_currentId, _currentLevel);

            await JS.InvokeVoidAsync("updateMapSummary", regionSummary);

            var listResponse = await EnrollHandler.GetRegionSummariesListAsync(new GetRegionSummariesListRequest
            {
                Year = year,
                ParentLevel = _currentLevel,
                ParentId = _currentId
            });

            if (_mapRendered && mapMarkersResponse?.Data != null)
            {
                await JS.InvokeVoidAsync("updateMarkers", mapMarkersResponse.Data);
            }

            if (listResponse.Data != null)
                await JS.InvokeVoidAsync("updateHoverCache", listResponse.Data);

            await LoadInsightsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar dashboard: {ex.Message}");
        }
        finally
        {
            if (isInitial) DashboardState.SetLoading(false);
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async void ApplyFilter(string? level, int? id)
    {
        _currentLevel = level;
        _currentId = id;

        var e = await GetEnrollmentWithCache(id, level);
        var r = await GetRatingWithCache(id, level);
        var i = await GetInfraWithCache(id, level);

        if (e != null && r != null && i != null)
        {
            regionSummary = e; ratingSummary = r; infraSummary = i;
            await JS.InvokeVoidAsync("updateMapSummary", regionSummary);
            StateHasChanged();
            _ = LoadDashboardDataAsync(isInitial: false, reloadMarkers: false);
        }
        else
        {
            await LoadDashboardDataAsync(isInitial: true, reloadMarkers: false);
        }
    }

    private string GetCacheKey(string? level, int? id) =>
        $"{level ?? "state"}_{id ?? 0}_{DashboardState.SelectedYear}_{DashboardState.SelectedDependency ?? 0}";

    private async Task<RegionEnrollmentSummaryDto?> GetEnrollmentWithCache(int? id, string? level)
    {
        var key = GetCacheKey(level, id);
        if (_enrollmentCache.TryGetValue(key, out var val)) return val;

        var request = new GetRegionEnrollmentSummaryByFilterRequest
        {
            Year = DashboardState.SelectedYear,
            MesorregiaoId = level == "meso" ? id : null,
            MicrorregiaoId = level == "micro" ? id : null,
            MunicipioId = level == "municipio" ? id : null,
            Depedencia = DashboardState.SelectedDependency
        };

        var res = await EnrollHandler.GetRegionEnrollmentSummaryByFilterAsync(request);
        if (res.Data != null) _enrollmentCache[key] = res.Data;
        return res.Data;
    }

    private async Task<RegionRatingSummaryDto?> GetRatingWithCache(int? id, string? level)
    {
        var key = GetCacheKey(level, id);
        if (_ratingCache.TryGetValue(key, out var val)) return val;

        var res = await RatingHandler.GetRegionRatingSummaryAsync(CreateRequest(id, level));
        if (res.Data != null) _ratingCache[key] = res.Data;
        return res.Data;
    }

    private async Task<RegionInfraSummaryDto?> GetInfraWithCache(int? id, string? level)
    {
        var key = GetCacheKey(level, id);
        if (_infraCache.TryGetValue(key, out var val)) return val;

        var res = await InfraHandler.GetRegionSummaryAsync(CreateRequest(id, level));
        if (res.Data != null) _infraCache[key] = res.Data;
        return res.Data;
    }

    private GetRegionSummaryRequest CreateRequest(int? id, string? level) => new()
    {
        Year = DashboardState.SelectedYear,
        MesorregiaoId = level == "meso" ? id : null,
        MunicipioId = level == "municipio" ? id : null,
        Dependencia = DashboardState.SelectedDependency
    };

    private async Task LoadInsightsAsync()
    {
        var request = new GetTargetInsightsByFilterRequest
        {
            Year = DashboardState.SelectedYear,
            Level = _currentLevel == "meso" ? "Mesoregion" : _currentLevel == "municipio" ? "Municipality" : "State",
            Target = _currentId ?? 27,
            Limit = 1
        };
        var res = await TargetInsightHandler.GetInsightsByFilterAsync(request);
        CurrentInsight = res?.Data?.FirstOrDefault();
    }

    private async void ReloadByYear() => await LoadDashboardDataAsync(isInitial: true, reloadMarkers: true);

    private async void ReloadByFilter()
    {
        _enrollmentCache.Clear();
        _ratingCache.Clear();
        _infraCache.Clear();

        await LoadDashboardDataAsync(isInitial: true, reloadMarkers: true);
    }

    private async Task GoBack() => await JS.InvokeVoidAsync("goBack");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_mapRendered && mapMarkersResponse?.Data != null)
        {
            _mapRendered = true;
            await JS.InvokeVoidAsync("initMap", "municipios.json", _objRef);
            await JS.InvokeVoidAsync("updateMarkers", mapMarkersResponse.Data);
        }
    }

    public void Dispose()
    {
        DashboardState.OnYearChanged -= ReloadByYear;
        DashboardState.OnFilterChanged -= ReloadByFilter;
        _objRef?.Dispose();
    }
}