@page "/"
@using Arkhos.Core.Handlers
@using Arkhos.Core.Models.Dto
@using Arkhos.Core.Models.Dto.SchoolEnrollValues
@using Arkhos.Core.Models.Dto.SchoolInfo
@using Arkhos.Core.Models.Dto.SchoolInfraValues
@using Arkhos.Core.Models.Dto.SchoolRating
@using Arkhos.Core.Requests.SchoolEnrollValues
@using Arkhos.Core.Requests.SchoolInfos
@using Arkhos.Core.Requests.SchoolInfraValues
@using Arkhos.Core.Requests.SchoolRatings
@using Arkhos.Core.Responses
@using Arkhos.Web.Components.Dashboards.Cards
@using Arkhos.Web.Handlers

@inject ISchoolInfosHandler Handler
@inject ISchoolRatingsHandler RatingHandler
@inject ISchoolEnrollValuesHandler EnrollHandler
@inject ISchoolEnrollValuesHandler TeachersHandler
@inject ISchoolInfraValuesHandler InfraHandler
@inject DashboardStateService DashboardState
@inject IJSRuntime JS

<PageTitle>Dashboard</PageTitle>

<AiInsightCard Title="@InsightTitle" HighlightValue="@($"{Math.Round((TotalAprovados * 100 ?? 0), 1)}%")"
               Recommendation="@InsightRecommendation" />

<MudGrid Spacing="2">
    <MudItem xs="12" md="6">
        <MudStack Spacing="4">
            <MudPaper Elevation="3" Class="d-flex align-center justify-center mud-width-full"
                      Style="position: relative; height: 500px">
                <div id="map" style="height:100%; width:100%; border-radius: 8px;"></div>
                <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" Label="Voltar"
                        Size="Size.Small" Style="position: absolute; top: 10px; right: 10px; z-index: 1000;"
                        @onclick="GoBack" />
            </MudPaper>

            <FinancialOverviewCard AvgStudent="@AvgSpendingPerStudent" AvgTeacher="@AvgSpendingPerTeacher"
                                   AvgInfra="@AvgInfrastructure" AvgTransport="@AvgTransport" AvgMeal="@AvgMeal"
                                   TotalGasto="@TotalGasto" />
                
        </MudStack>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudStack Spacing="2">
                    <EnrollmentOverviewCard Ano="@DashboardState.SelectedYear" TotalCreche="@TotalCreche"
                                            TotalPreEscola="@TotalPreEscola" TotalFundIniciais="@TotalFundIniciais"
                                            TotalFundFinais="@TotalFundFinais" TotalMedio="@TotalMedio" />

                    
                    <GovernanceSupportCard Psychologists="8" SocialAssistants="12" Libras="5" HasCouncil="true"
                                           HasParentsAssociation="true" HasStudentUnion="false" />
                </MudStack>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudStack Spacing="2">
                    <PieChartDropoutRateCard TotalAbandonos="@TotalAbandonos" TotalAprovados="@TotalAprovados"
                                             TotalReprovados="@TotalReprovados" />

                    <InfrastructureQualityCard Accessibility="@AcessibilityRating" Pedagogical="@TotalPedagogicalRooms" WellBeing="@TotalWellbeing" />

                    <TeachersOverviewCard Ano="@DashboardState.SelectedYear" TotalCreche="@ProfCreche"
                                          TotalPreEscola="@ProfPreEscola" TotalFundIniciais="@ProfFundIniciais"
                                          TotalFundFinais="@ProfFundFinais" TotalMedio="@ProfMedio" TotalEspecial="@ProfEspecial" />

                </MudStack>
            </MudItem>
        </MudGrid>

    </MudItem>

</MudGrid>

@code {
    private Response<ICollection<SchoolInfoMapDto>>? response;
    private Response<ICollection<SchoolRatingSpendingDto>>? spendingRatings;
    private Response<ICollection<SchoolRatingMapDto>>? ratings;
    private Response<ICollection<SchoolEnrollValuesStudentsDto>>? enrollments;
    private Response<ICollection<SchoolEnrollValuesTeachersDto>>? teachers;
    private Response<ICollection<SchoolInfraValuesPedagogicalRoomsDto>>? pedagogicalRooms;
    private Response<ICollection<SchoolInfraValuesWellbeingDto>>? wellbeingInfra;
    private Response<ICollection<SchoolRatingDropDto>>? dropouts;
    private bool _mapRendered = false;
    private IEnumerable<SchoolRatingSpendingDto> FilteredSpending => GetFilteredSpendingRatings();
    private IEnumerable<SchoolEnrollValuesStudentsDto> FilteredEnrollments => GetFilteredEnrollments();
    private IEnumerable<SchoolEnrollValuesTeachersDto> FilteredTeachers => GetFilteredTeachers();
    private IEnumerable<SchoolRatingMapDto> FilteredRatings => GetFilteredRatings();
    private IEnumerable<SchoolInfraValuesPedagogicalRoomsDto> FilteredPedagogicalRooms => GetFilteredPedagogicalRooms();
    private IEnumerable<SchoolInfraValuesWellbeingDto> FilteredWellbeing => GetFilteredWellbeing();

    
    private DotNetObjectReference<Home>? _objRef;

    private string? _currentLevel;
    private int? _currentId;

    protected override async Task OnInitializedAsync()
    {
        _objRef = DotNetObjectReference.Create(this);

        DashboardState.OnYearChanged += ReloadByYear;

        await LoadDashboardDataAsync();
    }

    private async void ReloadByYear()
    {
        await LoadDashboardDataAsync();

        if (response?.Data != null)
            await JS.InvokeVoidAsync("updateMarkers", response.Data);

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadDashboardDataAsync()
    {
        DashboardState.SetLoading(true);

        try
        {
            var request = new GetSchoolInfoByYearRequest
            {
                Year = DashboardState.SelectedYear
            };
            response = await Handler.GetByYearAsync(request);

            var spendingRatingRequest = new GetSchoolRatingSpendingByYearRequest
            {
                Year = DashboardState.SelectedYear
            };
            spendingRatings = await RatingHandler.GetSpendingByYearAsync(spendingRatingRequest);

            var ratingsRequest = new GetSchoolRatingMapByYearRequest
            {
                Year = DashboardState.SelectedYear
            };
            ratings = await RatingHandler.GetRatingByYearAsync(ratingsRequest);

            var wellbeingInfraRequest = new GetSchoolInfraValuesWellbeingByYearRequest
            {
                Year = DashboardState.SelectedYear
            };
            wellbeingInfra = await InfraHandler.GetWellbeingByYearAsync(wellbeingInfraRequest);

            var pedagogicalInfraRequest = new GetSchoolInfraValuesPedagogicalRoomsByYearRequest
            {
                Year = DashboardState.SelectedYear
            };
            pedagogicalRooms = await InfraHandler.GetPedagogicalRoomsByYearAsync(pedagogicalInfraRequest);

            var enrollmentRequest = new GetStudentsWithSeriesByYearRequest
            {
                Year = DashboardState.SelectedYear
            };
            enrollments = await EnrollHandler.GetStudentsWithSeriesByYearAsync(enrollmentRequest);

            var teacherRequest = new GetTeachersWithSeriesByYearRequest
            {
                Year = DashboardState.SelectedYear
            };
            teachers = await TeachersHandler.GetTeachersWithSeriesByYearAsync(teacherRequest);

            var dropoutRequest = new GetSchoolRatingDropByYearRequest
            {
                Year = DashboardState.SelectedYear
            };
            dropouts = await RatingHandler.GetDropByYearAsync(dropoutRequest);
        }
        finally
        {
            DashboardState.SetLoading(false);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_mapRendered && response?.Data != null)
        {
            _mapRendered = true;

            await JS.InvokeVoidAsync("initMap", "municipios.json", _objRef);
            await JS.InvokeVoidAsync("updateMarkers", response.Data);
        }
    }

    private async Task GoBack()
    {
        await JS.InvokeVoidAsync("goBack");
    }

    [JSInvokable]
    public void ApplyFilter(string? level, int? id)
    {
        _currentLevel = level;
        _currentId = id;
        StateHasChanged(); // Força a atualização dos cards
    }

    private IEnumerable<SchoolEnrollValuesTeachersDto> GetFilteredTeachers()
    {
        if (teachers?.Data == null) return Enumerable.Empty<SchoolEnrollValuesTeachersDto>();
        if (_currentId == null) return teachers.Data;

        return _currentLevel switch
        {
            "meso" => teachers.Data.Where(x => x.MesorregiaoId == _currentId),
            "micro" => teachers.Data.Where(x => x.MicrorregiaoId == _currentId),
            "municipio" => teachers.Data.Where(x => x.MunicipioId == _currentId),
            _ => teachers.Data
        };
    }
    private IEnumerable<SchoolRatingDropDto> GetFilteredDropouts()
    {
        if (dropouts?.Data == null) return Enumerable.Empty<SchoolRatingDropDto>();
        if (_currentId == null) return dropouts.Data;

        return _currentLevel switch
        {
            "meso" => dropouts.Data.Where(x => x.MesorregiaoId == _currentId),
            "micro" => dropouts.Data.Where(x => x.MicrorregiaoId == _currentId),
            "municipio" => dropouts.Data.Where(x => x.MunicipioId == _currentId),
            _ => dropouts.Data
        };
    }
    private IEnumerable<SchoolRatingSpendingDto> GetFilteredSpendingRatings()
    {
        if (spendingRatings?.Data == null) return Enumerable.Empty<SchoolRatingSpendingDto>();

        if (_currentId == null) return spendingRatings.Data;

        return _currentLevel switch
        {
            "meso" => spendingRatings.Data.Where(x => x.MesorregiaoId == _currentId),
            "micro" => spendingRatings.Data.Where(x => x.MicrorregiaoId == _currentId),
            "municipio" => spendingRatings.Data.Where(x => x.MunicipioId == _currentId),
            _ => spendingRatings.Data
        };
    }
    private IEnumerable<SchoolRatingMapDto> GetFilteredRatings()
    {
        if (ratings?.Data == null) return Enumerable.Empty<SchoolRatingMapDto>();

        if (_currentId == null) return ratings.Data;

        return _currentLevel switch
        {
            "meso" => ratings.Data.Where(x => x.MesorregiaoId == _currentId),
            "micro" => ratings.Data.Where(x => x.MicrorregiaoId == _currentId),
            "municipio" => ratings.Data.Where(x => x.MunicipioId == _currentId),
            _ => ratings.Data
        };
    }
    private IEnumerable<SchoolInfraValuesPedagogicalRoomsDto> GetFilteredPedagogicalRooms()
    {
        if (pedagogicalRooms?.Data == null) return Enumerable.Empty<SchoolInfraValuesPedagogicalRoomsDto>();
        if (_currentId == null) return pedagogicalRooms.Data;

        return _currentLevel switch
        {
            "micro" => pedagogicalRooms.Data.Where(x => x.MicrorregiaoId == _currentId),
            "municipio" => pedagogicalRooms.Data.Where(x => x.MunicipioId == _currentId),
            _ => pedagogicalRooms.Data
        };
    }

    private IEnumerable<SchoolInfraValuesWellbeingDto> GetFilteredWellbeing()
    {
        if (wellbeingInfra?.Data == null) return Enumerable.Empty<SchoolInfraValuesWellbeingDto>();
        if (_currentId == null) return wellbeingInfra.Data;

        return _currentLevel switch
        {
            "micro" => wellbeingInfra.Data.Where(x => x.MicrorregiaoId == _currentId),
            "municipio" => wellbeingInfra.Data.Where(x => x.MunicipioId == _currentId),
            _ => wellbeingInfra.Data
        };
    }

    private IEnumerable<SchoolEnrollValuesStudentsDto> GetFilteredEnrollments()
    {
        if (enrollments?.Data == null) return Enumerable.Empty<SchoolEnrollValuesStudentsDto>();
        if (_currentId == null) return enrollments.Data;

        return _currentLevel switch
        {
            "meso" => enrollments.Data.Where(x => x.MesorregiaoId == _currentId),
            "micro" => enrollments.Data.Where(x => x.MicrorregiaoId == _currentId),
            "municipio" => enrollments.Data.Where(x => x.MunicipioId == _currentId),
            _ => enrollments.Data
        };
    }

    private double AcessibilityRating => FilteredRatings.Any() ? FilteredRatings.Average(x => x.RatingAcessibilidade) : 0;

    private double AvgSpendingPerStudent =>
        FilteredSpending.Any() ? FilteredSpending.Average(x => x.SpendingPerStudent) / 12 : 0;

    private double AvgSpendingPerTeacher =>
        FilteredSpending.Any() ? FilteredSpending.Average(x => x.SpendingPerTeacher) / 12 : 0;

    private double AvgInfrastructure =>
       FilteredSpending.Any() ? FilteredSpending.Average(x => x.InfrastructureSpendingPerStudent) / 12 : 0;

    private double AvgTransport =>
        FilteredSpending.Any() ? FilteredSpending.Average(x => x.TransportSpendingPerStudent) / 12 : 0;

    private double AvgMeal =>
        FilteredSpending.Any() ? FilteredSpending.Average(x => x.MealSpendingPerStudent) / 12 : 0;
    
    private double TotalGasto => ((TotalAlunos * AvgSpendingPerStudent) / 12);

    private const int TotalWellbeingItems = 14;
    private double TotalWellbeing => FilteredWellbeing.Any()
    ? FilteredWellbeing.Average(x => SumWellbeingProperties(x) / TotalWellbeingItems)
    : 0;

    private double SumWellbeingProperties(SchoolInfraValuesWellbeingDto x)
    {
        return x.AlimentacaoEscolar +
               x.AreaVerde +
               x.BanheiroAlunos +
               x.BanheiroEducacaoInfantil +
               x.Cozinha +
               x.Despensa +
               x.ParqueInfantil +
               x.PatioCoberto +
               x.PatioDescoberto +
               x.Piscina +
               x.QuadraEsportes +
               x.Refeitorio +
               x.SalaRepousoAluno +
               x.Terreirao;
    }
    private const int TotalPedagogicalRoomsItems = 10;

    private double TotalPedagogicalRooms => FilteredPedagogicalRooms.Any()
        ? FilteredPedagogicalRooms.Average(x => SumPedagogicalRoomsProperties(x) / TotalPedagogicalRoomsItems)
        : 0;

     private double SumPedagogicalRoomsProperties(SchoolInfraValuesPedagogicalRoomsDto x)
    {
        return x.Auditorio +
               x.Biblioteca +
               x.LaboratorioCiencias +
               x.LaboratorioInformatica +
               x.SalaAtelieArtes +
               x.SalaMusicaCoral +
               x.SalaEstudioDanca +
               x.SalaLeitura +
               x.SalaMultiuso +
               x.SalaEstudioGravacao;
    }

    private double TotalCreche => FilteredEnrollments.Sum(x => x.MatriculaCreche);
    private double TotalPreEscola => FilteredEnrollments.Sum(x => x.MatriculaPreEscola);
    private double TotalFundIniciais => FilteredEnrollments.Sum(x => x.Matricula1Ano + x.Matricula2Ano + x.Matricula3Ano +
x.Matricula4Ano + x.Matricula5Ano);
    private double TotalFundFinais => FilteredEnrollments.Sum(x => x.Matricula6Ano + x.Matricula7Ano + x.Matricula8Ano +
x.Matricula9Ano);
    private double TotalMedio => FilteredEnrollments.Sum(x => x.MatriculaMedio1Ano + x.MatriculaMedio2Ano +
x.MatriculaMedio3Ano);
    private double TotalAlunos =>
        TotalCreche + TotalPreEscola + TotalFundIniciais + TotalFundFinais + TotalMedio;
    private double ProfCreche => FilteredTeachers.Sum(x => x.ProfessorCreche);
    private double ProfPreEscola => FilteredTeachers.Sum(x => x.ProfessorPreEscola);
    private double ProfFundIniciais => FilteredTeachers.Sum(x => x.ProfessorEFIniciais);
    private double ProfFundFinais => FilteredTeachers.Sum(x => x.ProfessorEFFinais);
    private double ProfMedio => FilteredTeachers.Sum(x => x.ProfessorMedio);
    private double ProfEspecial => FilteredTeachers.Sum(x => x.ProfessorEspecial);

    private double? TotalAbandonos => GetFilteredDropouts().Average(x => x.DropoutRate);
    private double? TotalAprovados => GetFilteredDropouts().Average(x => x.ApprovalRate);
    private double? TotalReprovados => GetFilteredDropouts().Average(x => x.FailureRate);

    private string InsightTitle => $"Aprovação média atinge {Math.Round(((TotalAprovados * 100) ?? 0), 1)}% nas regiões analisadas";
    private string InsightDescription => "A análise consolidada identificou predominância de aprovação escolar nas regiões filtradas, com estabilidade nos índices de abandono.";
    private string InsightRecommendation => "Reforçar ações nas regiões com reprovação acima da média e manter alocação eficiente de docentes.";

    public void Dispose()
    {
        DashboardState.OnYearChanged -= ReloadByYear;
        _objRef?.Dispose();
    }
}